# House No. 230 - Environment Configuration
# Copy this file to .env and supply environment-specific values.

# Database: SQLite for local dev/testing, PostgreSQL for production.
# SQLite local example: "file:./dev.db"
# PostgreSQL production example: "postgresql://user:password@host:5432/houseno230?schema=public&sslmode=prefer"
DATABASE_URL="file:./dev.db"

# Session / JWT Secret (Minimum 32 characters in production)
SESSION_SECRET="change-this-to-a-secure-random-32-char-string-in-production"

# Operational Timezone
TIMEZONE="Asia/Kolkata"

# App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional External Integrations (Leave empty if not yet provisioned by restaurant)
# WHATSAPP_PHONE_NUMBER="+919876543210"
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_USER="notifications@houseno230.com"
# SMTP_PASS="secure-smtp-password"
# S3_BUCKET_NAME="house-no-230-assets"
