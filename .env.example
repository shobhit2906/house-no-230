# Environment Configuration Template for House No. 230

# 1. DATABASE
# For Local Development (SQLite):
DATABASE_URL="file:./dev.db"

# For Production (PostgreSQL - e.g. Supabase, Neon, Railway, AWS RDS):
# DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@[YOUR-HOST]:5432/postgres?sslmode=require"

# 2. AUTHENTICATION & SESSION SECURITY
# Secret key used for signing tamper-evident admin JWT tokens (Minimum 32 characters, recommended 64-character random string)
SESSION_SECRET="generate-a-secure-random-64-character-string-for-production"
# Note: JWT_SECRET is also supported as an alias for backward compatibility

# 3. INITIAL ADMIN PROVISIONING (Used only once when initializing an empty database)
# ADMIN_INITIAL_EMAIL="admin@houseno230.com"
# ADMIN_INITIAL_PASSWORD="your-strong-production-admin-password"

# 4. PUBLIC URL
# Base domain of your live website
NEXT_PUBLIC_APP_URL="https://houseno230.com"

# 5. ENVIRONMENT
NODE_ENV="production"
